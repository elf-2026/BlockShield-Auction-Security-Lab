# BlockShield frontend environment — copy to .env.local and adjust values.
# .env.local is git-ignored; scripts/dev.sh regenerates it on every deploy.

# JSON-RPC endpoint of the local chain
VITE_RPC_URL=http://127.0.0.1:8545

# Deployed CommitRevealAuction address (dev.sh injects the fresh one)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Expected chain id (Anvil default)
VITE_CHAIN_ID=31337

# scripts/dev.sh tuning (not read by the frontend):
# COMMIT_DURATION=120   commit-phase length in seconds (min 60, enforced on-chain)
# REVEAL_DURATION=180   reveal-phase length in seconds (min 60, enforced on-chain)
# RPC_URL=http://127.0.0.1:8545

# Integration tests (npm run test:integration):
# INTEGRATION_RPC_URL=http://127.0.0.1:8545
# INTEGRATION_CONTRACT=0x5FbDB2315678afecb367f032d93F642f64180aa3

# NEVER put private keys or seed phrases in any .env file. Local Anvil dev
# accounts are unlocked by design; the browser signs via eth_sendTransaction.
